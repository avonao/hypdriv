{
  "name": "@hypdriv/testing",
  "version": "0.1.0",
  "description": "Hypdriv testing kit: fake bindings (KV, R2, Durable Objects, Queues), request builders, pipeline harness and vitest presets.",
  "license": "MIT",
  "author": "Avonao",
  "homepage": "https://hypdriv.dev",
  "bugs": "https://github.com/avonao/hypdriv/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.9"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avonao/hypdriv.git",
    "directory": "packages/testing"
  },
  "keywords": [
    "nextjs",
    "cloudflare",
    "workers",
    "edge",
    "hypdriv"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./vitest": {
      "source": "./src/vitest.ts",
      "types": "./dist/vitest.d.ts",
      "default": "./dist/vitest.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run && vitest run -c vitest.workers.config.ts"
  },
  "dependencies": {
    "@hypdriv/core": "workspace:*"
  },
  "peerDependencies": {
    "@cloudflare/vitest-plugin": ">=1.0.0",
    "vitest": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "@cloudflare/vitest-plugin": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
