{
  "name": "@hypdriv/nuxt",
  "version": "0.1.0",
  "description": "Hypdriv for Nuxt 4: a Nuxt module that runs the Hypdriv Drivetrain around every Nitro response (security headers, CSP nonces and hashes, rate limiting, bot shield, geo, flags, Early Hints, observability) and writes the route manifest and static headers for Cloudflare Workers, Vercel and Node.",
  "license": "MIT",
  "author": "Avonao",
  "homepage": "https://hypdriv.dev",
  "bugs": "https://github.com/avonao/hypdriv/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.19"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avonao/hypdriv.git",
    "directory": "packages/nuxt"
  },
  "keywords": [
    "nuxt",
    "nuxt-module",
    "nitro",
    "cloudflare",
    "workers",
    "vercel",
    "csp",
    "security",
    "hypdriv"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "source": "./src/server.ts",
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./runtime/*": {
      "types": "./dist/runtime/*.d.ts",
      "default": "./dist/runtime/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@hypdriv/build": "workspace:*",
    "@hypdriv/cloudflare": "workspace:*",
    "@hypdriv/core": "workspace:*",
    "@hypdriv/flags": "workspace:*",
    "@hypdriv/nitro": "workspace:*",
    "@hypdriv/runtime": "workspace:*",
    "@hypdriv/vite": "workspace:*"
  },
  "peerDependencies": {
    "nuxt": ">=4.6.0 <5",
    "vite": ">=8.0.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "h3": "catalog:",
    "nitropack": "catalog:",
    "nuxt": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:"
  }
}
