{
  "name": "@hypdriv/qwik",
  "version": "0.1.0",
  "description": "Hypdriv for Qwik (Qwik v2 and Qwik Router, on Vite): server-entry middleware and platform adapters that run the Hypdriv Drivetrain (security headers, CSP, rate limiting, bot shield, flags, observability, /_hypdriv/*) around Qwik's request handler on Cloudflare Workers, Vercel and Node, and a Vite plugin that writes the route manifest, CSP hashes and static headers from the Qwik build.",
  "license": "MIT",
  "author": "Avonao",
  "homepage": "https://hypdriv.dev",
  "bugs": "https://github.com/avonao/hypdriv/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.19"
  },
  "files": [
    "dist",
    "virtual.d.ts",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avonao/hypdriv.git",
    "directory": "packages/qwik"
  },
  "keywords": [
    "qwik",
    "qwik-router",
    "resumability",
    "vite-plugin",
    "cloudflare",
    "workers",
    "vercel",
    "csp",
    "security",
    "hypdriv"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./adapters/node": {
      "source": "./src/adapters/node.ts",
      "types": "./dist/adapters/node.d.ts",
      "default": "./dist/adapters/node.js"
    },
    "./adapters/vercel": {
      "source": "./src/adapters/vercel.ts",
      "types": "./dist/adapters/vercel.d.ts",
      "default": "./dist/adapters/vercel.js"
    },
    "./adapters/cloudflare": {
      "source": "./src/adapters/cloudflare.ts",
      "types": "./dist/adapters/cloudflare.d.ts",
      "default": "./dist/adapters/cloudflare.js"
    },
    "./middleware/node": {
      "source": "./src/middleware/node.ts",
      "types": "./dist/middleware/node.d.ts",
      "default": "./dist/middleware/node.js"
    },
    "./middleware/vercel": {
      "source": "./src/middleware/vercel.ts",
      "types": "./dist/middleware/vercel.d.ts",
      "default": "./dist/middleware/vercel.js"
    },
    "./middleware/cloudflare": {
      "source": "./src/middleware/cloudflare.ts",
      "types": "./dist/middleware/cloudflare.d.ts",
      "default": "./dist/middleware/cloudflare.js"
    },
    "./durable-objects": {
      "source": "./src/durable-objects.ts",
      "types": "./dist/durable-objects.d.ts",
      "default": "./dist/durable-objects.js"
    },
    "./server": {
      "source": "./src/server.ts",
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./virtual": {
      "types": "./virtual.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@hypdriv/build": "workspace:*",
    "@hypdriv/cloudflare": "workspace:*",
    "@hypdriv/core": "workspace:*",
    "@hypdriv/runtime": "workspace:*",
    "@hypdriv/vite": "workspace:*"
  },
  "peerDependencies": {
    "@qwik.dev/core": ">=2.0.0-rc.4 <3",
    "@qwik.dev/router": ">=2.0.0-rc.4 <3",
    "vite": ">=8.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@qwik.dev/core": "catalog:",
    "@qwik.dev/router": "catalog:",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
