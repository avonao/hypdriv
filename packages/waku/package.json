{
  "name": "@hypdriv/waku",
  "version": "0.1.0",
  "description": "Hypdriv for Waku: server-entry adapters and a Vite plugin that run the Hypdriv Drivetrain (security headers, CSP, rate limiting, bot shield, flags, observability, /_hypdriv/*) around Waku's React Server Components server, and write the route manifest, CSP hashes and static headers for Cloudflare Workers, Vercel and Node.",
  "license": "MIT",
  "author": "Avonao",
  "homepage": "https://hypdriv.dev",
  "bugs": "https://github.com/avonao/hypdriv/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.15"
  },
  "files": [
    "dist",
    "virtual.d.ts",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avonao/hypdriv.git",
    "directory": "packages/waku"
  },
  "keywords": [
    "waku",
    "react-server-components",
    "rsc",
    "vite-plugin",
    "cloudflare",
    "workers",
    "vercel",
    "csp",
    "security",
    "hypdriv"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./adapters/node": {
      "source": "./src/adapters/node.ts",
      "types": "./dist/adapters/node.d.ts",
      "default": "./dist/adapters/node.js"
    },
    "./adapters/vercel": {
      "source": "./src/adapters/vercel.ts",
      "types": "./dist/adapters/vercel.d.ts",
      "default": "./dist/adapters/vercel.js"
    },
    "./adapters/cloudflare": {
      "source": "./src/adapters/cloudflare.ts",
      "types": "./dist/adapters/cloudflare.d.ts",
      "default": "./dist/adapters/cloudflare.js"
    },
    "./durable-objects": {
      "source": "./src/durable-objects.ts",
      "types": "./dist/durable-objects.d.ts",
      "default": "./dist/durable-objects.js"
    },
    "./server": {
      "source": "./src/server.ts",
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./virtual": {
      "types": "./virtual.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@hypdriv/build": "workspace:*",
    "@hypdriv/cloudflare": "workspace:*",
    "@hypdriv/core": "workspace:*",
    "@hypdriv/runtime": "workspace:*",
    "@hypdriv/vite": "workspace:*"
  },
  "peerDependencies": {
    "vite": ">=8.0.0",
    "waku": ">=1.0.0-rc.4 <2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-server-dom-webpack": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "waku": "catalog:",
    "wrangler": "catalog:"
  }
}
