{
  "name": "create-hypdriv",
  "version": "0.1.0",
  "description": "Scaffold a Next.js 16 app with Hypdriv on Cloudflare Workers (OpenNext) or Vercel, optionally styled with Purser CSS.",
  "license": "MIT",
  "author": "Avonao",
  "homepage": "https://hypdriv.dev",
  "bugs": "https://github.com/avonao/hypdriv/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.9"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avonao/hypdriv.git",
    "directory": "packages/create-hypdriv"
  },
  "keywords": [
    "nextjs",
    "cloudflare",
    "workers",
    "vercel",
    "create",
    "scaffold",
    "hypdriv"
  ],
  "bin": {
    "create-hypdriv": "./dist/index.js"
  },
  "exports": {
    ".": {
      "source": "./src/api.ts",
      "types": "./dist/api.d.ts",
      "default": "./dist/api.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "sync-templates": "node scripts/sync-templates.mjs",
    "build": "tsdown && node scripts/sync-templates.mjs",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
