{
  "name": "@hypdriv/rwsdk",
  "version": "0.1.0",
  "description": "Hypdriv for RedwoodSDK (rwsdk, React Server Components on Vite and Cloudflare Workers): the Drivetrain (security headers, nonce CSP, rate limiting, bot shield, geo, flags, Early Hints, logging, Server-Timing, /_hypdriv/*) around the Worker's fetch, the route manifest read from defineApp's own routes, and a Vite plugin that writes the manifest, the static headers and the Durable Object exports.",
  "license": "MIT",
  "author": "Avonao",
  "homepage": "https://hypdriv.dev",
  "bugs": "https://github.com/avonao/hypdriv/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist",
    "virtual.d.ts",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avonao/hypdriv.git",
    "directory": "packages/rwsdk"
  },
  "keywords": [
    "rwsdk",
    "redwoodsdk",
    "react-server-components",
    "rsc",
    "vite-plugin",
    "cloudflare",
    "workers",
    "durable-objects",
    "csp",
    "security",
    "hypdriv"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./worker": {
      "source": "./src/worker.ts",
      "types": "./dist/worker.d.ts",
      "default": "./dist/worker.js"
    },
    "./wrap": {
      "source": "./src/wrap.ts",
      "types": "./dist/wrap.d.ts",
      "default": "./dist/wrap.js"
    },
    "./durable-objects": {
      "source": "./src/durable-objects.ts",
      "types": "./dist/durable-objects.d.ts",
      "default": "./dist/durable-objects.js"
    },
    "./server": {
      "source": "./src/server.ts",
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./virtual": {
      "types": "./virtual.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@hypdriv/build": "workspace:*",
    "@hypdriv/cloudflare": "workspace:*",
    "@hypdriv/core": "workspace:*",
    "@hypdriv/runtime": "workspace:*",
    "@hypdriv/vite": "workspace:*"
  },
  "peerDependencies": {
    "rwsdk": ">=1.0.0 <2",
    "vite": ">=8.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-server-dom-webpack": "catalog:",
    "rwsdk": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
