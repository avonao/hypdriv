{
  "name": "@hypdriv/nitro",
  "version": "0.1.0",
  "description": "Hypdriv for Nitro 2 and Nitro 3: a Nitro module that runs the Hypdriv Drivetrain around every response (security headers, CSP nonces and hashes, rate limiting, bot shield, geo, flags, Early Hints, observability) and writes the route manifest and static headers for Cloudflare Workers, Vercel and Node. The shared Nitro layer of the framework hosts built on Nitro.",
  "license": "MIT",
  "author": "Avonao",
  "homepage": "https://hypdriv.dev",
  "bugs": "https://github.com/avonao/hypdriv/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.19"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avonao/hypdriv.git",
    "directory": "packages/nitro"
  },
  "keywords": [
    "nitro",
    "nitropack",
    "nitro-module",
    "cloudflare",
    "workers",
    "vercel",
    "csp",
    "security",
    "hypdriv"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "source": "./src/vite.ts",
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./server": {
      "source": "./src/server.ts",
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./runtime/nitro2/*": {
      "source": "./src/runtime/nitro2/*.ts",
      "types": "./dist/runtime/nitro2/*.d.ts",
      "default": "./dist/runtime/nitro2/*.js"
    },
    "./runtime/prerendered": {
      "source": "./src/runtime/prerendered.ts",
      "types": "./dist/runtime/prerendered.d.ts",
      "default": "./dist/runtime/prerendered.js"
    },
    "./runtime/*": {
      "types": "./dist/runtime/*.d.ts",
      "default": "./dist/runtime/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@hypdriv/build": "workspace:*",
    "@hypdriv/cloudflare": "workspace:*",
    "@hypdriv/core": "workspace:*",
    "@hypdriv/flags": "workspace:*",
    "@hypdriv/runtime": "workspace:*",
    "@hypdriv/vite": "workspace:*"
  },
  "peerDependencies": {
    "nitro": ">=3.0.0-rc <4",
    "nitropack": ">=2.12.0 <3",
    "vite": ">=8.0.0"
  },
  "peerDependenciesMeta": {
    "nitro": {
      "optional": true
    },
    "nitropack": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "h3": "catalog:",
    "nitro": "catalog:",
    "nitropack": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
