{
  "name": "@hypdriv/sveltekit",
  "version": "0.1.0",
  "description": "Hypdriv for SvelteKit: a wrapper adapter that writes the route manifest, CSP hashes and static headers for Cloudflare, Vercel and Node, a `handle` hook that runs the Drivetrain around every server response, the Cloudflare Worker shell and a Node server.",
  "license": "MIT",
  "author": "Avonao",
  "homepage": "https://hypdriv.dev",
  "bugs": "https://github.com/avonao/hypdriv/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.17"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avonao/hypdriv.git",
    "directory": "packages/sveltekit"
  },
  "keywords": [
    "sveltekit",
    "svelte",
    "vite",
    "cloudflare",
    "workers",
    "vercel",
    "csp",
    "security",
    "hypdriv"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./hooks": {
      "source": "./src/hooks.ts",
      "types": "./dist/hooks.d.ts",
      "default": "./dist/hooks.js"
    },
    "./server": {
      "source": "./src/server.ts",
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./worker": {
      "source": "./src/worker.ts",
      "types": "./dist/worker.d.ts",
      "default": "./dist/worker.js"
    },
    "./durable-objects": {
      "source": "./src/durable-objects.ts",
      "types": "./dist/durable-objects.d.ts",
      "default": "./dist/durable-objects.js"
    },
    "./node": {
      "source": "./src/node/index.ts",
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@hypdriv/build": "workspace:*",
    "@hypdriv/cloudflare": "workspace:*",
    "@hypdriv/core": "workspace:*",
    "@hypdriv/runtime": "workspace:*",
    "@hypdriv/security": "workspace:*",
    "@hypdriv/vite": "workspace:*"
  },
  "peerDependencies": {
    "@sveltejs/kit": "^3.0.0",
    "vite": ">=8.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@sveltejs/kit": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@types/node": "catalog:",
    "svelte": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
