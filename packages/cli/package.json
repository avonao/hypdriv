{
  "name": "@hypdriv/cli",
  "version": "0.1.0",
  "description": "The hypdriv command for Cloudflare Workers, Vercel and Node: init, doctor, analyze, routes, audit, budget, csp, css, warm, purge, bench, deps, jobs, vitals, manifest, serve, agent.",
  "license": "MIT",
  "author": "Avonao",
  "homepage": "https://hypdriv.dev",
  "bugs": "https://github.com/avonao/hypdriv/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.9"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avonao/hypdriv.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "nextjs",
    "cloudflare",
    "workers",
    "edge",
    "hypdriv"
  ],
  "bin": {
    "hypdriv": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./bin": {
      "source": "./src/bin.ts",
      "types": "./dist/bin.d.ts",
      "default": "./dist/bin.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@hypdriv/core": "workspace:*",
    "@hypdriv/observe": "workspace:*",
    "@hypdriv/security": "workspace:*",
    "@hypdriv/purser": "workspace:*",
    "@hypdriv/next": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@hypdriv/vite": "workspace:*"
  },
  "peerDependencies": {
    "@hypdriv/vite": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@hypdriv/vite": {
      "optional": true
    }
  }
}
