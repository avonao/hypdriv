{
  "name": "hypdriv",
  "version": "0.1.0",
  "description": "Hypdriv — performance, security and observability for Next.js 16+ on Cloudflare Workers, Vercel and Node. Umbrella package re-exporting the @hypdriv/* modules a Next.js app needs and the hypdriv CLI.",
  "license": "MIT",
  "author": "Avonao",
  "homepage": "https://hypdriv.dev",
  "bugs": "https://github.com/avonao/hypdriv/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.9"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avonao/hypdriv.git",
    "directory": "packages/hypdriv"
  },
  "keywords": [
    "nextjs",
    "cloudflare",
    "workers",
    "edge",
    "hypdriv",
    "vercel"
  ],
  "bin": {
    "hypdriv": "./bin/hypdriv.js"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./config": {
      "source": "./src/config.ts",
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./next": {
      "source": "./src/next.ts",
      "types": "./dist/next.d.ts",
      "default": "./dist/next.js"
    },
    "./proxy": {
      "source": "./src/proxy.ts",
      "types": "./dist/proxy.d.ts",
      "default": "./dist/proxy.js"
    },
    "./cloudflare": {
      "source": "./src/cloudflare.ts",
      "types": "./dist/cloudflare.d.ts",
      "default": "./dist/cloudflare.js"
    },
    "./durable-objects": {
      "source": "./src/durable-objects.ts",
      "types": "./dist/durable-objects.d.ts",
      "default": "./dist/durable-objects.js"
    },
    "./vercel": {
      "source": "./src/vercel.ts",
      "types": "./dist/vercel.d.ts",
      "default": "./dist/vercel.js"
    },
    "./server": {
      "source": "./src/server.ts",
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./client": {
      "source": "./src/client.tsx",
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./cache": {
      "source": "./src/cache.ts",
      "types": "./dist/cache.d.ts",
      "default": "./dist/cache.js"
    },
    "./instrumentation": {
      "source": "./src/instrumentation.ts",
      "types": "./dist/instrumentation.d.ts",
      "default": "./dist/instrumentation.js"
    },
    "./security": {
      "source": "./src/security.ts",
      "types": "./dist/security.d.ts",
      "default": "./dist/security.js"
    },
    "./flags": {
      "source": "./src/flags.ts",
      "types": "./dist/flags.d.ts",
      "default": "./dist/flags.js"
    },
    "./live": {
      "source": "./src/live.ts",
      "types": "./dist/live.d.ts",
      "default": "./dist/live.js"
    },
    "./observe": {
      "source": "./src/observe.ts",
      "types": "./dist/observe.d.ts",
      "default": "./dist/observe.js"
    },
    "./image": {
      "source": "./src/image.ts",
      "types": "./dist/image.d.ts",
      "default": "./dist/image.js"
    },
    "./purser": {
      "source": "./src/purser.ts",
      "types": "./dist/purser.d.ts",
      "default": "./dist/purser.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@hypdriv/cache": "workspace:*",
    "@hypdriv/cli": "workspace:*",
    "@hypdriv/cloudflare": "workspace:*",
    "@hypdriv/core": "workspace:*",
    "@hypdriv/devtools": "workspace:*",
    "@hypdriv/flags": "workspace:*",
    "@hypdriv/image": "workspace:*",
    "@hypdriv/live": "workspace:*",
    "@hypdriv/next": "workspace:*",
    "@hypdriv/observe": "workspace:*",
    "@hypdriv/purser": "workspace:*",
    "@hypdriv/security": "workspace:*",
    "@hypdriv/vercel": "workspace:*"
  },
  "peerDependencies": {
    "next": ">=16.0.0",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
