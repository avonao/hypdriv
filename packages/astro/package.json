{
  "name": "@hypdriv/astro",
  "version": "0.1.0",
  "description": "Hypdriv for Astro: an integration that runs the Hypdriv Drivetrain (security headers, CSP, rate limiting, bot shield, flags, observability, /_hypdriv/*) around Astro's middleware and writes the route manifest, CSP hashes and static headers for Cloudflare Workers, Vercel and Node.",
  "license": "MIT",
  "author": "Avonao",
  "homepage": "https://hypdriv.dev",
  "bugs": "https://github.com/avonao/hypdriv/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist",
    "virtual.d.ts",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avonao/hypdriv.git",
    "directory": "packages/astro"
  },
  "keywords": [
    "astro",
    "astro-integration",
    "withastro",
    "cloudflare",
    "workers",
    "vercel",
    "csp",
    "security",
    "hypdriv"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./middleware": {
      "source": "./src/middleware.ts",
      "types": "./dist/middleware.d.ts",
      "default": "./dist/middleware.js"
    },
    "./internal-route": {
      "source": "./src/internal-route.ts",
      "types": "./dist/internal-route.d.ts",
      "default": "./dist/internal-route.js"
    },
    "./server": {
      "source": "./src/server.ts",
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./fetch": {
      "source": "./src/fetch.ts",
      "types": "./dist/fetch.d.ts",
      "default": "./dist/fetch.js"
    },
    "./virtual": {
      "types": "./virtual.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@hypdriv/build": "workspace:*",
    "@hypdriv/core": "workspace:*",
    "@hypdriv/runtime": "workspace:*",
    "@hypdriv/vite": "workspace:*"
  },
  "peerDependencies": {
    "astro": ">=7.0.0",
    "vite": ">=8.0.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "astro": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
