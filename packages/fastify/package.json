{
  "name": "@hypdriv/fastify",
  "version": "0.1.0",
  "description": "Hypdriv for Fastify 5 on Node and Vercel Functions: the Drivetrain (security headers, CSP with per-request nonces, rate limiting, bot shield, geo, flags, redirects, Early Hints, logging, Server-Timing, /_hypdriv/*) as an encapsulation-breaking Fastify plugin built on the request lifecycle hooks, plus a route manifest collected with onRoute.",
  "license": "MIT",
  "author": "Avonao",
  "homepage": "https://hypdriv.dev",
  "bugs": "https://github.com/avonao/hypdriv/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avonao/hypdriv.git",
    "directory": "packages/fastify"
  },
  "keywords": [
    "fastify",
    "node",
    "vercel",
    "csp",
    "security",
    "rate-limiting",
    "plugin",
    "hypdriv"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@hypdriv/core": "workspace:*",
    "@hypdriv/runtime": "workspace:*",
    "fastify-plugin": "catalog:"
  },
  "peerDependencies": {
    "fastify": ">=5.0.0 <6"
  },
  "devDependencies": {
    "@fastify/compress": "catalog:",
    "@fastify/formbody": "catalog:",
    "@fastify/static": "catalog:",
    "@fastify/websocket": "catalog:",
    "@types/node": "catalog:",
    "fastify": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
