{
  "name": "@hypdriv/example-tanstack-start",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:cloudflare": "HYPDRIV_TARGET=cloudflare vite build",
