{
  "name": "@hypdriv/example-waku",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "waku dev",
    "build": "waku build",
    "build:cloudflare": "HYPDRIV_TARGET=cloudflare waku build",
    "build:vercel": "HYPDRIV_TARGET=vercel waku build",
    "build:node": "HYPDRIV_TARGET=node waku build",
    "start": "waku start --port 3000",
    "preview:cloudflare": "wrangler dev --config dist/server/wrangler.json",
    "deploy:cloudflare": "HYPDRIV_TARGET=cloudflare waku build && wrangler deploy --config dist/server/wrangler.json",
    "hypdriv:audit": "hypdriv audit all --url http://localhost:3000",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hypdriv/core": "workspace:*",
    "@hypdriv/waku": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-server-dom-webpack": "catalog:",
    "waku": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@hypdriv/cli": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "wrangler": "catalog:"
  }
}
