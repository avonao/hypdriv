{
  "name": "@hypdriv/example-vinext",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:cloudflare": "HYPDRIV_TARGET=cloudflare vite build",
    "build:vercel": "HYPDRIV_TARGET=vercel vite build",
    "build:node": "HYPDRIV_TARGET=node vite build",
    "start": "vinext start",
    "preview": "vite preview",
    "preview:cloudflare": "wrangler dev --config dist/server/wrangler.json",
    "deploy:cloudflare": "HYPDRIV_TARGET=cloudflare vite build && wrangler deploy --config dist/server/wrangler.json",
    "hypdriv:audit": "hypdriv audit all --url http://localhost:3000",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hypdriv/cloudflare": "workspace:*",
    "@hypdriv/core": "workspace:*",
    "@hypdriv/vinext": "workspace:*",
    "@vinext/cloudflare": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-server-dom-webpack": "catalog:",
    "vinext": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@hypdriv/cli": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitejs/plugin-rsc": "catalog:",
    "nitro": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "wrangler": "catalog:"
  }
}
