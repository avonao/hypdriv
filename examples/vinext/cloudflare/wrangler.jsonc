{
  // Kept out of the project root: vinext refuses Node and Nitro builds of a project that has a root wrangler
  // config. A Cloudflare-only app keeps this file as ./wrangler.jsonc (and drops `configPath` in vite.config.ts).
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "hypdriv-vinext",
  "main": "../worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // The Worker runs first for everything except vinext's content-hashed assets, so every page, Route Handler and
  // public file gets the full pipeline.
  "assets": {
    "directory": "../dist/client",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": ["/*", "!/_next/static/*", "!/*/_next/static/*"]
  },
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      { "name": "HYPDRIV_LIMITER", "class_name": "HypDrivLimiter" },
      { "name": "HYPDRIV_INDEX", "class_name": "HypDrivIndex" },
      { "name": "HYPDRIV_CHANNEL", "class_name": "HypDrivChannel" }
    ]
  },
  "migrations": [
    { "tag": "hypdriv-v1", "new_sqlite_classes": ["HypDrivChannel", "HypDrivLimiter", "HypDrivIndex"] }
  ]
}
