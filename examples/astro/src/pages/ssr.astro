---
import RequestFacts from '../components/RequestFacts.astro';
import Layout from '../layouts/Layout.astro';

// Rendered per request: HypDriv injects the request's nonce into every script and style.
export const prerender = false;
---

<Layout title="On demand · HypDriv × Astro">
  <h1>Rendered on demand</h1>
  <RequestFacts />
  <p id="status">Scripts did not run.</p>
  <script>
    const status = document.querySelector('#status');
    if (status) status.textContent = 'Bundled script ran with the request nonce.';
  </script>
  <script is:inline>
    document.documentElement.dataset.inline = 'ran';
  </script>
</Layout>
