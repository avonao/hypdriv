---
import { hyp } from '@hypdriv/astro/server';
import Layout from '../layouts/Layout.astro';

// Rendered on demand when a route throws. Astro runs the middleware again for this page; HypDriv applies the
// response stages (headers, CSP) to it without counting the request against rate limits twice.
export const prerender = false;
const ctx = hyp();
---

<Layout title="Something went wrong">
  <h1>Something went wrong</h1>
  <p>Request <code data-fact="request-id">{ctx?.requestId ?? 'none'}</code> failed.</p>
</Layout>
