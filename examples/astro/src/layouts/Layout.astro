---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <nav>
      <a href="/">Home (prerendered)</a>
      <a href="/ssr">On demand</a>
      <a href="/blog/hello">Blog</a>
      <a href="/api/hello">API</a>
    </nav>
    <main>
      <slot />
    </main>
  </body>
</html>

<style>
  body {
    font-family: system-ui, sans-serif;
    margin: 2rem auto;
    max-width: 48rem;
    line-height: 1.5;
  }
  nav {
    display: flex;
    gap: 1rem;
  }
</style>
