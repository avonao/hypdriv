# Copy to .env.local for `next dev`; on Vercel set these in Project Settings → Environment Variables
# (or `vercel env add`). `vercel env pull .env.local` fetches them for local development.

# Signs internal requests (`hypdriv jobs run`, `hypdriv audit` tokens). 32+ random bytes.
HYPDRIV_INTERNAL_SECRET=
# Encrypts HypDriv sessions. 32+ random bytes.
HYPDRIV_SESSION_SECRET=

# Optional: Upstash Redis (Vercel Marketplace) — exact global rate-limit counters and a read-write KV.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: Global Config (formerly Edge Config) — flags, redirects and the maintenance switch.
GLOBAL_CONFIG=
