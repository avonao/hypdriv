{
  // Read by @cloudflare/vite-plugin. The build writes the deployable configuration to dist/worker/wrangler.json and
  // points .wrangler/deploy/config.json at it, so `wrangler deploy` uses it.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hypdriv-rwsdk",
  "main": "src/worker.tsx",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // The Worker runs first for everything except RedwoodSDK's content-hashed assets, so every page, RSC payload,
  // server function and public file gets the full pipeline; the Worker serves public files from ASSETS itself.
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/assets/*"]
  },
  "observability": { "enabled": true },
  // The classes are exported from src/worker.tsx by the Hypdriv Vite plugin.
  "durable_objects": {
    "bindings": [
      { "name": "HYPDRIV_LIMITER", "class_name": "HypDrivLimiter" },
      { "name": "HYPDRIV_INDEX", "class_name": "HypDrivIndex" },
      { "name": "HYPDRIV_CHANNEL", "class_name": "HypDrivChannel" }
    ]
  },
  "migrations": [
    { "tag": "hypdriv-v1", "new_sqlite_classes": ["HypDrivChannel", "HypDrivLimiter", "HypDrivIndex"] }
  ]
}
