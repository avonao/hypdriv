{
  "include": [
    ".react-router/types/**/*",
    "app/**/*",
    "workers/**/*",
    "vite.config.ts",
    "react-router.config.ts",
    "hypdriv.config.ts"
  ],
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "rootDirs": [".", "./.react-router/types"],
    "types": ["@cloudflare/workers-types", "vite/client", "node"]
  }
}
