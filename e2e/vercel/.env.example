# Copy to .env.local for `next dev`; provisioning (`pnpm provision`) sets these on the Vercel project.
HYPDRIV_INTERNAL_SECRET=
HYPDRIV_SESSION_SECRET=
CRON_SECRET=
# Global Config (formerly Edge Config): flags, redirects and maintenance without a redeploy.
GLOBAL_CONFIG=
# Turnstile (per environment; Cloudflare's always-pass test keys work in CI).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional: Upstash Redis from the Vercel Marketplace (exact rate limits).
KV_REST_API_URL=
KV_REST_API_TOKEN=
