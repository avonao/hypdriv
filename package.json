{
  "name": "hypdriv-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "HypDriv — the Hyper-Extension for Next.js 16+ on Cloudflare Workers and Vercel.",
  "license": "MIT",
  "author": "Avonao",
  "homepage": "https://hypdriv.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avonao/hypdriv.git"
  },
  "bugs": "https://github.com/avonao/hypdriv/issues",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=20.9",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' run build",
    "dev": "pnpm -r --parallel --filter './packages/**' run dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --filter './packages/**' run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "clean": "pnpm -r --filter './packages/**' exec rm -rf dist .turbo && rm -rf node_modules/.vite",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm build && changeset publish",
    "publint": "pnpm -r --filter './packages/**' exec publint",
    "doctor": "node packages/cli/dist/bin.js doctor"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "catalog:",
    "@types/node": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
